NODE_ENV=development
PORT=5000
# Neon pooled URL for the running API (hostname contains -pooler).
# For local PostgreSQL, use postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require
# Neon direct/unpooled URL for Prisma migrations and introspection.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
ADMIN_EMAIL=admin@paachcharam.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-12-or-more-characters

# Configure these to enable password reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cloudinary signed server-side image uploads (all three values required).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mux direct video uploads (server-side credentials only).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_MAX_VIDEO_UPLOAD_BYTES=2000000000
